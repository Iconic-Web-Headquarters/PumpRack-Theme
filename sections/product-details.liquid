                {%- when 'legal' -%}
          <details-disclosure {{ block.shopify_attributes }}>
                     
                                {%- if block.settings.legal -%}
                                  {% if product.metafields.custom.manufacturer.value == 'Viking®' %}
            <div class="legal_msg_container">
              <div class="legal_inner">
                {% if block.settings.legal_message_content != blank %}
                <div class="deatails_flex_no">
                  <div class="legal_desc">
                    {{ block.settings.legal_message_content}}
                  </div>
                </div>
            {% endif %}

              </div>
            </div>
             {% endif %}
            {% endif %}
