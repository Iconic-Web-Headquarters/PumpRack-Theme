<div class="tabs_filter_main">
  <div class="container">
    <div class="tabs_filter_main_inner">
      <div class="tabs_button">
        {% if section.settings.tab_btn != blank %}
          <div class="tab_btn_icon warranty active">
            {% if section.settings.tabs_btn_icon != blank %}
              <img class="tab_icon" src="{{ section.settings.tabs_btn_icon | img_url:'master' }}">
            {% endif %}
            <button id="warranty" class="tabs_btn ">{{ section.settings.tab_btn }}</button>
          </div>
        {% endif %}

        {% if section.settings.tab_btn2 != blank %}
          <div class="tab_btn_icon Build">
            {% if section.settings.tabs_btn_icon2 != blank %}
              <img class="tab_icon" src="{{ section.settings.tabs_btn_icon2 | img_url:'master' }}">
            {% endif %}
            <button id="Build" class="tabs_btn">{{ section.settings.tab_btn2 }}</button>
          </div>
        {% endif %}

        {% if section.settings.tab_btn3 != blank %}
          <div class="tab_btn_icon Condition">
            {% if section.settings.tabs_btn_icon3 != blank %}
              <img class="tab_icon" src="{{ section.settings.tabs_btn_icon3 | img_url:'master' }}">
            {% endif %}
            <button id="Condition" class="tabs_btn">{{ section.settings.tab_btn3 }}</button>
          </div>
        {% endif %}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'warranty-content' -%}
            <div class="warranty-content">
              <div class="warranty-content-inner">
                <div class="warranty_content_one">{{ block.settings.warranty_content_one }}</div>

                {% if block.settings.warranty_content_box != blank %}
                  <div class="warranty_content_with_icon">
                    <div class="warranty_content_with_icon_inner">
                      {% if block.settings.warranty_content_with_icon != blank %}
                        <img src="{{ block.settings.warranty_content_with_icon | img_url:'master' }}">
                      {% endif %}
                    </div>
                    <div class="warranty_content_box">
                      {{ block.settings.warranty_content_box }}
                    </div>
                  </div>
                {% endif %}

                {% if block.settings.warranty_content_box2 != blank %}
                  <div class="warranty_content_with_icon">
                    <div class="warranty_content_with_icon_inner">
                      {% if block.settings.warranty_content_with_icon2 != blank %}
                        <img src="{{ block.settings.warranty_content_with_icon2 | img_url:'master' }}">
                      {% endif %}
                    </div>
                    <div class="warranty_content_box">
                      {{ block.settings.warranty_content_box2 }}
                    </div>
                  </div>
                {% endif %}

                {% if block.settings.warranty_content_box3 != blank %}
                  <div class="warranty_content_with_icon">
                    <div class="warranty_content_with_icon_inner">
                      {% if block.settings.warranty_content_with_icon3 != blank %}
                        <img src="{{ block.settings.warranty_content_with_icon3 | img_url:'master' }}">
                      {%- endif %}
                    </div>
                    <div class="warranty_content_box">
                      {{ block.settings.warranty_content_box3 }}
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>

          {%- when 'Build-to-Order' -%}
            <div class="Build-to-Order-content">
              <div class="Build-to-Order-content-inner">
                <div class="Build-to-Order_headings">
                  <h1 class="Build-to-Order_heading_h1">{{ block.settings.Build_heading }}</h1>
                  <h2 class="Build-to-Order_heading_h2">{{ block.settings.Build_subheading }}</h2>
                </div>
                <div class="Build-to-Order_content">
                  {{ block.settings.Build_Content }}
                </div>

                <div class="content_with_image">
                  <div class="Build-to-Order_content_with_icon">
                    <div class="icon_text rte icon_flex">
                      {%- if block.settings.custom_icon1 != blank -%}
                        <img
                          src="{{ block.settings.custom_icon1 | img_url:'master' }}"
                          class="custom_icon"
                        >
                      {%- endif -%}

                      {%- if block.settings.icon_text1 != blank -%}
                        <p class="custom_icon__text">
                          {{ block.settings.icon_text1 }}
                        </p>
                      {%- endif -%}
                    </div>

                    <div class="icon_text rte icon_flex">
                      {%- if block.settings.custom_icon2 != blank -%}
                        <img
                          src="{{ block.settings.custom_icon2 | img_url:'master' }}"
                          class="custom_icon"
                        >
                      {%- endif -%}

                      {%- if block.settings.icon_text2 != blank -%}
                        <p class="custom_icon__text">
                          {{ block.settings.icon_text2 }}
                        </p>
                      {%- endif -%}
                    </div>

                    <div class="icon_text rte icon_flex">
                      {%- if block.settings.custom_icon3 != blank -%}
                        <img
                          src="{{ block.settings.custom_icon3 | img_url:'master' }}"
                          class="custom_icon"
                        >
                      {%- endif -%}

                      {%- if block.settings.icon_text3 != blank -%}
                        <p class="custom_icon__text">
                          {{ block.settings.icon_text3 }}
                        </p>
                      {%- endif -%}
                    </div>

                    <div class="icon_text rte icon_flex">
                      {%- if block.settings.custom_icon4 != blank -%}
                        <img
                          src="{{ block.settings.custom_icon4 | img_url:'master' }}"
                          class="custom_icon"
                        >
                      {%- endif -%}

                      {%- if block.settings.icon_text4 != blank -%}
                        <p class="custom_icon__text">
                          {{ block.settings.icon_text4 }}
                        </p>
                      {%- endif -%}
                    </div>

                    <div class="icon_text rte icon_flex">
                      {%- if block.settings.custom_icon5 != blank -%}
                        <img
                          src="{{ block.settings.custom_icon5 | img_url:'master' }}"
                          class="custom_icon"
                        >
                      {%- endif -%}

                      {%- if block.settings.icon_text5 != blank -%}
                        <p class="custom_icon__text">
                          {{ block.settings.icon_text5 }}
                        </p>
                      {%- endif -%}
                    </div>
                    <div class="Build-to-Order_content_box">
                      {{ block.settings.Build_to_order_content_box }}
                    </div>
                  </div>
                  <div class="Build-to-Order_right_image">
                    {% if block.settings.build_content_right_img != blank %}
                      <img src="{{ block.settings.build_content_right_img | img_url:'master' }}">
                    {%- endif %}
                  </div>
                </div>
              </div>
            </div>

          {%- when 'Condition-Grading' -%}
            <div class="Condition-Grading">
              <div class="Condition-Grading-inner">
                <div class="Condition-Grading-container">
                  <div class="Condition-Grading-text-block">
                    {{ block.settings.grading_text_block_1 }}
                  </div>
                  <div class="Condition-Grading-text-box_main">
                    <div class="Condition-Grading-text-box">
                      <h3 class="box_heading">{{ block.settings.box_heading }}</h3>
                      <div class="box_text">{{ block.settings.box_text }}</div>
                    </div>
                    <div class="Condition-Grading-text-box">
                      <h3 class="box_heading">{{ block.settings.box_heading2 }}</h3>
                      <div class="box_text">{{ block.settings.box_text2 }}</div>
                    </div>

                    <div class="Condition-Grading-text-box">
                      <h3 class="box_heading">{{ block.settings.box_heading3 }}</h3>
                      <div class="box_text">{{ block.settings.box_text3 }}</div>
                    </div>
                  </div>
                </div>

                <div class="Condition-Grading-container">
                  <div class="Condition-Grading-text-block">
                    {{ block.settings.grading_text_block_2 }}
                  </div>
                  <div class="Condition-Grading-text-box_main">
                    <div class="Condition-Grading-text-box">
                      <h3 class="box_heading">{{ block.settings.box_heading4 }}</h3>
                      <div class="box_text">{{ block.settings.box_text4 }}</div>
                    </div>
                    <div class="Condition-Grading-text-box">
                      <h3 class="box_heading">{{ block.settings.box_heading5 }}</h3>
                      <div class="box_text">{{ block.settings.box_text5 }}</div>
                    </div>
                    <div class="Condition-Grading-text-box">
                      <h3 class="box_heading">{{ block.settings.box_heading6 }}</h3>
                      <div class="box_text">{{ block.settings.box_text6 }}</div>
                    </div>
                  </div>
                </div>

                <div class="Condition-Grading-container">
                  <div class="Condition-Grading-text-block">
                    {{ block.settings.grading_text_block_3 }}
                  </div>
                  <div class="Condition-Grading-text-box_main">
                    <div class="Condition-Grading-text-box">
                      <h3 class="box_heading">{{ block.settings.box_heading7 }}</h3>
                      <div class="box_text">{{ block.settings.box_text7 }}</div>
                    </div>
                    <div class="Condition-Grading-text-box">
                      <h3 class="box_heading">{{ block.settings.box_heading8 }}</h3>
                      <div class="box_text">{{ block.settings.box_text8 }}</div>
                    </div>
                    <div class="Condition-Grading-text-box">
                      <h3 class="box_heading">{{ block.settings.box_heading9 }}</h3>
                      <div class="box_text">{{ block.settings.box_text9 }}</div>
                    </div>
                  </div>
                </div>

                <div class="Condition-Grading-container">
                  <div class="Condition-Grading-text-block">
                    {{ block.settings.grading_text_block_4 }}
                  </div>
                  <div class="Condition-Grading-text-box_main">
                    <div class="Condition-Grading-text-box">
                      <h3 class="box_heading">{{ block.settings.box_heading10 }}</h3>
                      <div class="box_text">{{ block.settings.box_text10 }}</div>
                    </div>
                    <div class="Condition-Grading-text-box">
                      <h3 class="box_heading">{{ block.settings.box_heading11 }}</h3>
                      <div class="box_text">{{ block.settings.box_text11 }}</div>
                    </div>
                    <div class="Condition-Grading-text-box">
                      <h3 class="box_heading">{{ block.settings.box_heading12 }}</h3>
                      <div class="box_text">{{ block.settings.box_text12 }}</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {% if section.settings.show_rigth_form %}
      <div class="tabsfilter_form_right">
        <div class="support_form mega_form pruduct">
          {%- if section.settings.form_heading != blank -%}
            <div
              class="mb-heading reading-width rte cc-animate-init cc-animate-in"
              data-cc-animate
            >
              <h3 class="column_title">{{ section.settings.form_heading | escape }}</h3>
              <p class="column_desc">{{ section.settings.form_desc }}</p>
            </div>
          {%- endif -%}

          {%- form 'contact', id: form_id, class: 'form reading-width' -%}
            <div class="form__grid grid grid-cols-2 gap-x-theme gap-y-6" data-cc-animate>
              <div class="col-span-2 is-required">
                <input
                  type="text"
                  class="input w-full"
                  id="{{ form_id }}-part"
                  name="contact[{{ 'contact.form.part' | t }}]"
                  pattern="[0-9\-]*"
                  placeholder="Type Of Part"
                  autocomplete="part"
                  value="{% if form.part %}{{ form.part }}{% elsif customer %}{{ customer.part}}{% endif %}"
                  aria-required="true"
                  required
                >
              </div>
              <div class="col-span-2 is-required">
                <input
                  type="text"
                  class="input w-full"
                  id="{{ form_id }}-partnumber"
                  name="contact[{{ 'contact.form.partnumber' | t }}]"
                  pattern="[0-9\-]*"
                  placeholder="Part Number"
                  autocomplete="partnumber"
                  value="{% if form.partnumber %}{{ form.partnumber }}{% elsif customer %}{{ customer.partnumber}}{% endif %}"
                  aria-required="true"
                  required
                >
              </div>
              <div class="col-span-2 is-required">
                <input
                  type="text"
                  class="input w-full"
                  id="{{ form_id }}-name"
                  placeholder="Your Name"
                  name="contact[{{ 'contact.form.name' | t }}]"
                  autocomplete="name"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  aria-required="true"
                  required
                >
              </div>
              <div class="col-span-2 is-required">
                <input
                  type="email"
                  class="input w-full"
                  id="{{ form_id }}-email"
                  placeholder="Your Email"
                  name="contact[email]"
                  autocomplete="email"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  {%- if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="{{ form_id }}-email-error"
                  {%- endif %}
                  aria-required="true"
                  required
                >
              </div>

              <div class="col-span-2 is-required flexv2">
                <input
                  type="checkbox"
                  name="contact[email-subscribe]"
                  value="Email me monthly inventory updates and special offers."
                  aria-required="true"
                  required

                ><label
                  class="support_check"
                  for="Email me monthly inventory updates and special offers."
                  >Email me monthly inventory updates and special offers.</label
                >
              </div>

              {%- if form.errors contains block.type -%}
                <p class="form__field-error" id="{{ form_id }}-{{ block.type }}-error">
                  {{ form.errors.translated_fields[block.type] | capitalize }}
                  {{ form.errors.messages[block.type] }}
                </p>
              {%- endif -%}
            </div>

            {%- if form.posted_successfully? -%}
              <div
                class="alert mt-8 bg-success-bg text-success-text"
                tabindex="-1"
                autofocus
                {% if settings.animations_enabled != 'disabled' %}
                  data-cc-animate
                {% endif %}
              >
                {{ 'contact.form.post_success' | t }}
              </div>
            {%- elsif form.errors -%}
              <div
                class="alert mt-8 bg-error-bg text-error-text"
                tabindex="-1"
                autofocus
                {% if settings.animations_enabled != 'disabled' %}
                  data-cc-animate
                {% endif %}
              >
                <h2 class="h5 text-current">{{ 'contact.form.error_heading' | t }}</h2>
                <ul class="styled-list">
                  <li>
                    <a class="link text-current" href="#{{ form_id }}-email">
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </a>
                  </li>
                </ul>
              </div>
            {%- endif -%}

            {%- if section.blocks.size > 0 -%}
              <div
                class="mt-6"
                {% if settings.animations_enabled != 'disabled' %}
                  data-cc-animate
                {% endif %}
              >
                <button class="{{ section.settings.button_style }} menu_btn w-full md:w-auto">ASK AN EXPERT</button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
        <div class="custom_icon_with_text">
          <div class="footer-block__text rte icon_flex">
            {%- if section.settings.peripherals_custom_icon != blank -%}
              <img
                src="{{ section.settings.peripherals_custom_icon | img_url:'master' }}"
                class="custom_icon"
              >
            {%- endif -%}
            <div class="icon_text-inner-flex">
              {%- if section.settings.peripherals_icon_text != blank -%}
                <h4 class="custom_icon__title">
                  {{ section.settings.peripherals_icon_title }}
                </h4>
              {%- endif -%}

              {%- if section.settings.peripherals_icon_text != blank -%}
                <p class="custom_icon__text">
                  {{ section.settings.peripherals_icon_text }}
                </p>
              {%- endif -%}
            </div>
          </div>
          <div class="footer-block__text rte icon_flex">
            {%- if section.settings.peripherals_custom_icon2 != blank -%}
              <img
                src="{{ section.settings.peripherals_custom_icon2 | img_url:'master' }}"
                class="custom_icon"
              >
            {%- endif -%}
            <div class="icon_text-inner-flex">
              {%- if section.settings.peripherals_icon_text2 != blank -%}
                <h4 class="custom_icon__title">
                  {{ section.settings.peripherals_icon_title2 }}
                </h4>
              {%- endif -%}

              {%- if section.settings.peripherals_icon_text2 != blank -%}
                <p class="custom_icon__text">
                  {{ section.settings.peripherals_icon_text2 }}
                </p>
              {%- endif -%}
            </div>
          </div>
          <div class="footer-block__text rte icon_flex">
            {%- if section.settings.peripherals_custom_icon3 != blank -%}
              <img
                src="{{ section.settings.peripherals_custom_icon3 | img_url:'master' }}"
                class="custom_icon"
              >
            {%- endif -%}
            <div class="icon_text-inner-flex">
              {%- if section.settings.peripherals_icon_text3 != blank -%}
                <h4 class="custom_icon__title">
                  {{ section.settings.peripherals_icon_title3 }}
                </h4>
              {%- endif -%}

              {%- if section.settings.peripherals_icon_text3 != blank -%}
                <p class="custom_icon__text">
                  {{ section.settings.peripherals_icon_text3 }}
                </p>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

