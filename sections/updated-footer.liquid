<link rel="stylesheet" href="{{ 'footer.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
  <script src="{{ 'custom-select.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .footer {
    --bg-color: {{ section.settings.bg_color.rgba }};
    --heading-color: {{ section.settings.text_color.rgb }};
    --text-color: {{ section.settings.text_color.rgb }};
  }
{%- endstyle -%}


<footer class="footer bg-theme-bg text-theme-text">

  <div class="container">
      {%- if section.settings.show_back_to_top -%}
  <a href="#" class="back-to-top text-sm block border-top go-to-top_btn font-bold text-center text-current p-6 border-bottom"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
  <img src="https://cdn.shopify.com/s/files/1/0556/7971/3366/files/go-up.png?v=1721327371" class="go-to-top">  
  </a>
{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="footer__main md:flex md:flex-wrap mb-10 md:mb-6">
        {%- assign is_first_disclosure = true -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}


            {%- when 'text_with_icons' -%}
              <div class="footer-col footer-column-text_with_icons footer-col--links footer-col--not-collapsed{% if section.blocks.size == 1 %} footer-col--text-full-width{% endif %}" {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                <div class="footer-block mb-8 {{ block.settings.text_align }}">
                  {%- if block.settings.icon_heading != blank -%}
                    <h2 class="footer-block__heading font-body font-bold text-h6 regular-text">{{ block.settings.icon_heading | escape }}</h2>
                  {%- endif -%}
            
              <div class="footer-block__text rte icon_flex">
             {%- if block.settings.custom_icon  != blank -%}
            <img src="{{ block.settings.custom_icon | img_url:'master' }}" class="custom_icon">
             {%- endif -%}
            
                  {%- if block.settings.icon_text  != blank -%}
                    <div class="custom_icon__text">
                      {{ block.settings.icon_text }}
                    </div>
                  {%- endif -%}
             </div>
                   <div class="footer-block__text rte icon_flex">
             {%- if block.settings.custom_icon2  != blank -%}
            <img src="{{ block.settings.custom_icon2 | img_url:'master' }}" class="custom_icon">
             {%- endif -%}
            
                  {%- if block.settings.icon_text2  != blank -%}
                    <div class="custom_icon__text">
                      {{ block.settings.icon_text2 }}
                    </div>
                  {%- endif -%}
             </div>
                   <div class="footer-block__text rte icon_flex">
             {%- if block.settings.custom_icon3  != blank -%}
            <img src="{{ block.settings.custom_icon3 | img_url:'master' }}" class="custom_icon">
             {%- endif -%}
            
                  {%- if block.settings.icon_text3  != blank -%}
                    <div class="custom_icon__text">
                      {{ block.settings.icon_text3 }}
                    </div>
                  {%- endif -%}
             </div>

            {%- if block.settings.icon_heading2 != blank -%}
                    <h2 class="footer-block__heading font-body font-bold text-h6 regular-text bottom_heading">{{ block.settings.icon_heading2 | escape }}</h2>
                  {%- endif -%}

                          <div class="footer-block__text rte icon_flex bottom">
             {%- if block.settings.custom_icon4  != blank -%}
            <img src="{{ block.settings.custom_icon4 | img_url:'master' }}" class="custom_icon">
             {%- endif -%}
            
                  {%- if block.settings.icon_text4  != blank -%}
                    <div class="custom_icon__text">
                      {{ block.settings.icon_text4 }}
                    </div>
                  {%- endif -%}
             </div>
                  
                </div>
              </div>


            
            {%- when 'text' -%}
              <div class="footer-col footer-col--text footer-col--not-collapsed{% if section.blocks.size == 1 %} footer-col--text-full-width{% endif %}" {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                <div class="footer-block mb-8 {{ block.settings.text_align }}">
                  {%- if block.settings.image != blank -%}
                    <div class="media relative" style="max-width: {{ block.settings.image_width }}px;">
                      {% render 'image', class: "footer-block__image", image: block.settings.image, src_width: block.settings.image_width, srcset_2x: true %}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="footer-block__heading font-body font-bold text-h6 regular-text">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="footer-block__text rte">
                      {{ block.settings.text }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <div class="footer-block__btns">
                      <a class="btn btn--primary" {% if block.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %}>
                        {{- block.settings.button_label | escape -}}
                      </a>
                    </div>
                  {%- endif -%}
                  {%- if shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}
                    <div class="footer-block__btns">
                      {{ shop | login_button: action: 'follow' }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.show_social -%}
                    {%- liquid
                      if block.settings.text_align == "text-end"
                        assign class = "justify-end"
                      elsif block.settings.text_align == "text-center"
                        assign class = "justify-center"
                      else
                        assign class = "justify-start"
                      endif
                    -%}
                    <div class="footer-block__btns footer-block__social">
                      {% render 'social-media', icon: settings.social_custom_icon, icon_height: 24, class: class %}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- when 'form' -%}
            <div class="footer-col footer_form footer-col--text form footer-col--not-collapsed{% if section.blocks.size == 1 %} footer-col--text-full-width{% endif %}" {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
            <div class="footer-block mb-8 {{ block.settings.text_align }}">
                  <div class="support_form">
                {%- if block.settings.heading != blank -%}
      <div class="mb-heading reading-width rte cc-animate-init cc-animate-in" data-cc-animate>
        <h2 class="h4 section__heading">{{ block.settings.heading | escape }}</h2>
          <div class="card__rte flex-auto rte">
     {{ block.settings.form_desc}}
    </div>
      </div>
    {%- endif -%}


  {%- form 'contact', id: form_id, class: 'form reading-width' -%}
      <div class="form__grid grid grid-cols-2 gap-x-theme gap-y-6" data-cc-animate>
          <div class="col-span-2 md:col-span-1 is-required">
                <input type="text"
                       class="input w-full"
                       id="{{ form_id }}-name"
                  placeholder="{{ 'contact.form.name' | t }}"
                       name="contact[{{ 'contact.form.name' | t }}]"
                       autocomplete="name"
                       value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                         aria-required="true"
                         required>

          </div>
        <div class="col-span-2 md:col-span-1 is-required">
                <input type="email"
                       class="input w-full"
                       id="{{ form_id }}-email"
                  placeholder="{{ 'contact.form.email' | t }}"
                       name="contact[email]"
                       autocomplete="email"
                       value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                       {%- if form.errors contains 'email' %}
                         aria-invalid="true"
                         aria-describedby="{{ form_id }}-email-error"
                       {%- endif %}
                         aria-required="true"
                         required>
             </div>
        <div class="col-span-2 md:col-span-1 is-required">
                <input type="tel"
                       class="input w-full"
                       id="{{ form_id }}-phone"
                       name="contact[{{ 'contact.form.phone' | t }}]"
                       pattern="[0-9\-]*"
                  placeholder="{{ 'contact.form.phone' | t }}"
                       autocomplete="tel"
                       value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                         aria-required="true"
                         required>
               </div>
                <div class="col-span-2 md:col-span-1 is-required">
                <input type="text"
                       class="input w-full"
                       id="{{ form_id }}-equipment"
                       name="contact[{{ 'contact.form.equipment' | t }}]"
                       pattern="[0-9\-]*"
                  placeholder="Type of Equipment"
                       autocomplete="tel"
                       value="{% if form.equipment %}{{ form.equipment }}{% elsif customer %}{{ customer.equipment}}{% endif %}"
                         aria-required="true"
                         required>
                 </div>


            {%- if form.errors contains block.type -%}
              <p class="form__field-error" id="{{ form_id }}-{{ block.type }}-error">
                {{ form.errors.translated_fields[block.type] | capitalize }}
                {{ form.errors.messages[block.type] }}
              </p>
            {%- endif -%}
    
      </div>

      {%- if form.posted_successfully? -%}
        <div class="alert mt-8 bg-success-bg text-success-text" tabindex="-1" autofocus{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
          {{ 'contact.form.post_success' | t }}
        </div>
      {%- elsif form.errors -%}
        <div class="alert mt-8 bg-error-bg text-error-text" tabindex="-1" autofocus{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
          <h2 class="h5 text-current">{{ 'contact.form.error_heading' | t }}</h2>
          <ul class="styled-list">
            <li>
              <a class="link text-current" href="#{{ form_id }}-email">
                {{- form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] -}}
              </a>
            </li>
          </ul>
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="mt-6"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
          <button class="{{ section.settings.button_style }} w-full md:w-auto">GET STARTED</button>
        </div>
      {%- endif -%}
    {%- endform -%}      
              </div>
                  
                </div>
              </div>

              {%- when 'newsletter' -%}
              <div class="footer-col footer-col--newsletter{% if block.settings.collapse_mobile %} footer-col--collapsed{% else %} footer-col--not-collapsed{% endif %}" {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                {%- if block.settings.collapse_mobile -%}
                  <footer-menu>
                    <details class="footer-menu disclosure{% if is_first_disclosure %} footer-menu--first{% endif %}" open>
                      <summary tabindex="-1">
                        <div class="flex justify-between items-center">
                          <h2 class="disclosure__title font-body font-bold text-h6 regular-text">
                            {{ block.settings.heading | escape }}
                          </h2>
                          <span class="disclosure__toggle">
                            {%- if settings.disclosure_toggle == 'plus' -%}
                              {% render 'icon-plus' %}
                            {%- else -%}
                              {% render 'icon-chevron-down' %}
                            {%- endif -%}
                          </span>
                        </div>
                      </summary>
                      <div class="disclosure__panel has-motion">
                        <div class="disclosure__content">
                          {%- if block.settings.text != blank -%}
                            {{ block.settings.text }}
                          {%- endif -%}

                          {% render 'newsletter-signup', id: 'footer-signup', arrow_button: true, tags: 'newsletter' %}

                          <div class="footer_bottom_links">
                           {%- for link in linklists.footer-bottom.links -%}
                          <a href="{{ link.url }}" class="footer_bottom_links-menu_item loop-{{ forloop.index }}"><span>{{ link.title }} </span></a>
                          {% endfor %}
                          </div>
                        </div>
                      </div>
                    </details>
                  </footer-menu>
                  {%- assign is_first_disclosure = false -%}
                {%- else -%}
                  <div class="footer-block">
                    <h2 class="footer-block__heading font-body font-bold text-h6 regular-text">
                      {%- if block.settings.heading != blank -%}
                        {{ block.settings.heading | escape }}
                      {%- endif -%}
                    </h2>

                    {%- if block.settings.text != blank -%}
                      {{ block.settings.text }}
                    {%- endif -%}

                    {% render 'newsletter-signup', id: 'footer-signup', arrow_button: true, tags: 'newsletter' %}
                         <div class="footer_bottom_links">
                           {%- for link in linklists.footer-bottom.links -%}
                          <a href="{{ link.url }}" class="footer_bottom_links-menu_item loop-{{ forloop.index }}"><span>{{ link.title }} </span></a>
                          {% endfor %}
                          </div>
                  </div>
                {%- endif -%}

             
              </div>

            {%- when 'link_list' -%}
              {%- if block.settings.menu != blank and block.settings.heading != blank -%}
                <div class="footer-col footer-col--links footer-col--collapsed" {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                  <footer-menu>
                    <details class="footer-menu disclosure{% if is_first_disclosure %} footer-menu--first{% endif %}" open>
                      <summary tabindex="-1">
                        <div class="flex justify-between items-center">
                          <h2 class="disclosure__title font-body font-bold text-h6 regular-text">
                            {{- block.settings.heading | escape -}}
                          </h2>
                          <span class="disclosure__toggle">
                            {%- if settings.disclosure_toggle == 'plus' -%}
                              {% render 'icon-plus' %}
                            {%- else -%}
                              {% render 'icon-chevron-down' %}
                            {%- endif -%}
                          </span>
                        </div>
                      </summary>
                      <div class="disclosure__panel has-motion">
                        <ul class="footer-menu__links disclosure__content" role="list">
                          {%- for link in block.settings.menu.links -%}
                            <li>
                              <a href="{{ link.url }}">{{ link.title }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    </details>
                  </footer-menu>
                </div>
                {%- assign is_first_disclosure = false -%}
              {%- endif -%}
          {%- endcase -%}
