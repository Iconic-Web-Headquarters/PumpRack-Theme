        },
                {
          "type": "image_picker",
          "id": "custom_icon2",
          "label": "icon Image 2"
        },
        {
          "type": "text",
          "id": "icon_text2",
          "label": "icon Text 2",
          "default": "Shop By Manufacturer"
        },
                {
          "type": "image_picker",
          "id": "custom_icon3",
          "label": "icon Image 3"
        },
        {
          "type": "text",
          "id": "icon_text3",
          "label": "icon Text 3",
          "default": "Shop By Manufacturer"
        },
                {
          "type": "image_picker",
          "id": "custom_icon4",
          "label": "icon Image 4"
        },
        {
          "type": "text",
          "id": "icon_text4",
          "label": "icon Text 4",
          "default": "Shop By Manufacturer"
        },
             {
          "type": "image_picker",
          "id": "custom_icon5",
          "label": "icon Image 5"
        },
        {
          "type": "text",
          "id": "icon_text5",
          "label": "icon Text 5",
          "default": "Shop By Manufacturer"
        },
      {
      "type": "header",
      "content": "Button"
    },

       {
          "type": "text",
          "id": "button_1_label",
          "label": "Button 1 label",
          "default": "Optional button"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Button 1 link"
        }
  ],

"presets": [
  {
    "name": "Text with Img Grid"
  }
]
}
{% endschema %}

