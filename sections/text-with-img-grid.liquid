        },
      {
          "type": "text",
          "id": "second_heading",
          "label": "Second Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Text",
          "default": "<p>Pair text with an image to focus on a product, collection or blog post. Add details on availability, style, or even provide a review.</p>"
        },
       {
          "type": "richtext",
          "id": "description2",
          "label": "Text Bottom",
          "default": "<p>Pair text with an image to focus on a product, collection or blog post. Add details on availability, style, or even provide a review.</p>"
        },
    {
      "type": "header",
