                      </div>
                    </div>
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        {% if section.settings.show_rigth_form %}
          <div class="tabsfilter_form_right">
            <div class="support_form mega_form pruduct">
              {%- if section.settings.form_heading != blank -%}
                <div
                  class="mb-heading reading-width rte cc-animate-init cc-animate-in"
                  data-cc-animate
                >
                  <h3 class="column_title">{{ section.settings.form_heading | escape }}</h3>
                  <p class="column_desc">{{ section.settings.form_desc }}</p>
                </div>
              {%- endif -%}

              {%- form 'contact', id: form_id, class: 'form reading-width' -%}
                <div class="form__grid grid grid-cols-2 gap-x-theme gap-y-6" data-cc-animate>
                  <div class="col-span-2 is-required">
                    <input
                      type="text"
                      class="input w-full"
                      id="{{ form_id }}-part"
                      name="contact[{{ 'contact.form.part' | t }}]"
                      pattern="[0-9\-]*"
                      placeholder="Type Of Part"
                      autocomplete="part"
                      value="{% if form.part %}{{ form.part }}{% elsif customer %}{{ customer.part}}{% endif %}"
                      aria-required="true"
                      required
                    >
                  </div>
                  <div class="col-span-2 is-required">
                    <input
                      type="text"
                      class="input w-full"
                      id="{{ form_id }}-partnumber"
                      name="contact[{{ 'contact.form.partnumber' | t }}]"
                      pattern="[0-9\-]*"
                      placeholder="Part Number"
                      autocomplete="partnumber"
                      value="{% if form.partnumber %}{{ form.partnumber }}{% elsif customer %}{{ customer.partnumber}}{% endif %}"
                      aria-required="true"
                      required
                    >
                  </div>
                  <div class="col-span-2 is-required">
                    <input
                      type="text"
                      class="input w-full"
                      id="{{ form_id }}-name"
                      placeholder="Your Name"
                      name="contact[{{ 'contact.form.name' | t }}]"
                      autocomplete="name"
                      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                      aria-required="true"
                      required
                    >
                  </div>
                  <div class="col-span-2 is-required">
                    <input
                      type="email"
                      class="input w-full"
                      id="{{ form_id }}-email"
                      placeholder="Your Email"
                      name="contact[email]"
                      autocomplete="email"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      {%- if form.errors contains 'email' %}
                        aria-invalid="true"
                        aria-describedby="{{ form_id }}-email-error"
                      {%- endif %}
                      aria-required="true"
                      required
