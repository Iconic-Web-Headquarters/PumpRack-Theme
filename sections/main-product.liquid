                    <div class="content_with_image">
                      <div class="Build-to-Order_content_with_icon">
                        <div class="icon_text rte icon_flex">
                          {%- if block.settings.custom_icon1 != blank -%}
                            <img
                              src="{{ block.settings.custom_icon1 | img_url:'master' }}"
                              class="custom_icon"
                            >
                          {%- endif -%}

                          {%- if block.settings.icon_text1 != blank -%}
                            <p class="custom_icon__text">
                              {{ block.settings.icon_text1 }}
                            </p>
                          {%- endif -%}
                        </div>

                        <div class="icon_text rte icon_flex">
                          {%- if block.settings.custom_icon2 != blank -%}
                            <img
                              src="{{ block.settings.custom_icon2 | img_url:'master' }}"
                              class="custom_icon"
                            >
                          {%- endif -%}

                          {%- if block.settings.icon_text2 != blank -%}
                            <p class="custom_icon__text">
                              {{ block.settings.icon_text2 }}
                            </p>
                          {%- endif -%}
                        </div>

                        <div class="icon_text rte icon_flex">
                          {%- if block.settings.custom_icon3 != blank -%}
                            <img
                              src="{{ block.settings.custom_icon3 | img_url:'master' }}"
                              class="custom_icon"
                            >
                          {%- endif -%}

                          {%- if block.settings.icon_text3 != blank -%}
                            <p class="custom_icon__text">
                              {{ block.settings.icon_text3 }}
                            </p>
                          {%- endif -%}
                        </div>

                        <div class="icon_text rte icon_flex">
                          {%- if block.settings.custom_icon4 != blank -%}
                            <img
                              src="{{ block.settings.custom_icon4 | img_url:'master' }}"
                              class="custom_icon"
                            >
                          {%- endif -%}

                          {%- if block.settings.icon_text4 != blank -%}
                            <p class="custom_icon__text">
                              {{ block.settings.icon_text4 }}
                            </p>
                          {%- endif -%}
                        </div>

                        <div class="icon_text rte icon_flex">
                          {%- if block.settings.custom_icon5 != blank -%}
                            <img
                              src="{{ block.settings.custom_icon5 | img_url:'master' }}"
                              class="custom_icon"
                            >
                          {%- endif -%}

                          {%- if block.settings.icon_text5 != blank -%}
                            <p class="custom_icon__text">
                              {{ block.settings.icon_text5 }}
                            </p>
                          {%- endif -%}
                        </div>
                        <div class="Build-to-Order_content_box">
                          {{ block.settings.Build_to_order_content_box }}
                        </div>
                      </div>
                      <div class="Build-to-Order_right_image">
                        {% if block.settings.build_content_right_img != blank %}
                          <img src="{{ block.settings.build_content_right_img | img_url:'master' }}">
                        {%- endif %}
                      </div>
                    </div>
                  </div>
                </div>

              {%- when 'Condition-Grading' -%}
                <div class="Condition-Grading">
                  <div class="Condition-Grading-inner">
                    <div class="Condition-Grading-container">
                      <div class="Condition-Grading-text-block">
                        {{ block.settings.grading_text_block_1 }}
                      </div>
                      <div class="Condition-Grading-text-box_main">
                        <div class="Condition-Grading-text-box">
                          <h3 class="box_heading">{{ block.settings.box_heading }}</h3>
                          <div class="box_text">{{ block.settings.box_text }}</div>
                        </div>
                        <div class="Condition-Grading-text-box">
                          <h3 class="box_heading">{{ block.settings.box_heading2 }}</h3>
                          <div class="box_text">{{ block.settings.box_text2 }}</div>
                        </div>

                        <div class="Condition-Grading-text-box">
                          <h3 class="box_heading">{{ block.settings.box_heading3 }}</h3>
                          <div class="box_text">{{ block.settings.box_text3 }}</div>
                        </div>
                      </div>
                    </div>

                    <div class="Condition-Grading-container">
                      <div class="Condition-Grading-text-block">
                        {{ block.settings.grading_text_block_2 }}
                      </div>
                      <div class="Condition-Grading-text-box_main">
                        <div class="Condition-Grading-text-box">
                          <h3 class="box_heading">{{ block.settings.box_heading4 }}</h3>
                          <div class="box_text">{{ block.settings.box_text4 }}</div>
                        </div>
                        <div class="Condition-Grading-text-box">
                          <h3 class="box_heading">{{ block.settings.box_heading5 }}</h3>
                          <div class="box_text">{{ block.settings.box_text5 }}</div>
                        </div>
                        <div class="Condition-Grading-text-box">
                          <h3 class="box_heading">{{ block.settings.box_heading6 }}</h3>
                          <div class="box_text">{{ block.settings.box_text6 }}</div>
                        </div>
                      </div>
                    </div>

                    <div class="Condition-Grading-container">
                      <div class="Condition-Grading-text-block">
                        {{ block.settings.grading_text_block_3 }}
                      </div>
                      <div class="Condition-Grading-text-box_main">
                        <div class="Condition-Grading-text-box">
                          <h3 class="box_heading">{{ block.settings.box_heading7 }}</h3>
                          <div class="box_text">{{ block.settings.box_text7 }}</div>
                        </div>
                        <div class="Condition-Grading-text-box">
                          <h3 class="box_heading">{{ block.settings.box_heading8 }}</h3>
                          <div class="box_text">{{ block.settings.box_text8 }}</div>
                        </div>
                        <div class="Condition-Grading-text-box">
                          <h3 class="box_heading">{{ block.settings.box_heading9 }}</h3>
                          <div class="box_text">{{ block.settings.box_text9 }}</div>
                        </div>
                      </div>
                    </div>

                    <div class="Condition-Grading-container">
                      <div class="Condition-Grading-text-block">
                        {{ block.settings.grading_text_block_4 }}
                      </div>
                      <div class="Condition-Grading-text-box_main">
                        <div class="Condition-Grading-text-box">
                          <h3 class="box_heading">{{ block.settings.box_heading10 }}</h3>
                          <div class="box_text">{{ block.settings.box_text10 }}</div>
